<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the onboarding checklist to offer the battery-optimisation exemption dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- A timer must fire on time while the phone dozes in a pocket. Play policy reserves
         USE_EXACT_ALARM for apps whose core function is alarms, so this is the requestable
         variant with an inexact fallback (see AlarmTimerScheduler). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The finished-timer alert is a notification, which is how an app may vibrate/sound with the
         screen off on Android 13+. Requested at runtime in MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only used by the BootReceiver, which stays disabled until a timer exists. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The finished-timer alert vibrates directly when notifications are blocked. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Needed on Android 11+ to list installed launcher apps for per-app notification filtering. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingIsland">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NothingIsland">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Notification access: mirrors alerts into the island and unlocks MediaSession reads
            (getActiveSessions requires an enabled notification listener).
        -->
        <service
            android:name=".service.notification.IslandNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>

            <!--
                No default_filter_types metadata: an absent value means "allow all types".
                Declaring "conversations|alerting" made the OS withhold every SILENT notification
                (muted chats, gentle notifications) and every ONGOING one (calls, downloads, maps),
                so WhatsApp/Discord could look completely dead. Filtering is our job, in
                NotificationGate, where it is configurable and logged.
            -->
        </service>

        <!-- No manifest plug receiver: it cold-started the process only to no-op when the island
             was disabled. The running service observes plug transitions via ACTION_BATTERY_CHANGED. -->

        <!--
            Classic AccessibilityService overlay: no root, no SYSTEM_ALERT_WINDOW needed.
            The service draws the island and a 1 px inset probe; it does not inspect window content.
        -->
        <service
            android:name=".service.IslandService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Timer completion. Not exported: only our own PendingIntent arms it. -->
        <receiver
            android:name=".service.timer.TimerAlarmReceiver"
            android:exported="false" />

        <!--
            Re-arms a stored timer after a reboot. Disabled in the manifest and enabled at runtime
            only while a timer exists, so the app never cold-starts on boot for nothing.
        -->
        <receiver
            android:name=".service.timer.BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
