<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme: no AppCompat/Material XML dependency, Compose owns the UI. -->
    <style name="Theme.NothingIsland" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nothing_black</item>
        <item name="android:colorBackground">@color/nothing_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
